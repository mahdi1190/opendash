# https://editorconfig.org - shared editor settings. Matches the existing code:
# two-space indents, LF, UTF-8, a final newline (tests check it for src/).
root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

[*.md]
# Two trailing spaces are a line break in Markdown.
trim_trailing_whitespace = false

[*.{bat,cmd}]
end_of_line = crlf

[*.py]
indent_size = 4

[vendor/**]
# Third-party files stay exactly as shipped.
charset = unset
end_of_line = unset
indent_style = unset
indent_size = unset
insert_final_newline = unset
trim_trailing_whitespace = unset
