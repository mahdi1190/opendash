<?xml version="1.0" ?>
<!--
  tools/start-hidden.wsf - starts the OpenDash server with no window (Windows).

  Used only by the two opt-in switches in Settings > Server:
    "Start automatically when I log in"  (HKCU ...\CurrentVersion\Run, value personal-dashboard)
    "Enable the Start server button"     (HKCU\Software\Classes\dashboard-start)
  Both run:  wscript.exe "<app>\tools\start-hidden.wsf" [--port N] [--data-dir "<folder>"]

  It always runs start-opendash.bat from THIS app folder with no window
  (start-dashboard.bat when the folder has no start-opendash.bat: a switch
  registered by an older copy keeps working), with --no-open (and
  DASHBOARD_NO_PAUSE=1 so nothing waits for a key press in a window nobody
  can see). It never reads a URL: only a numeric --port and a
  plain X:\ --data-dir are taken, in order, and reading stops at the first
  anything else - so even text Windows might add after them (a link) is never
  read. A dashboard-start:// link cannot add anything to the command.
  It does nothing when a dashboard already answers on the port, or when it
  was started less than 20 s ago (a log-in start plus a click, a double
  click, or a page that opens the link over and over), so it can never pile
  up builds and migrations. Stop the hidden server from Settings > Server >
  Stop server (or Task Manager: Node.js).
  DASHBOARD_LAUNCHER_DRY_RUN=<folder> (tests, with cscript): print what it
  would do instead of doing it, and keep its time stamp in <folder>.
  JScript (not VBScript, which Windows is phasing out).
-->
<job id="start-hidden">
<script language="JScript"><![CDATA[
var SAFE = /^[^"%!^&|<>\r\n\t]+$/;
var DRIVE = /^[A-Za-z]:\\/;
var COOLDOWN_MS = 20000;

/** The registered arguments, in order; stops at the first anything else. -> {port, extra[]} */
function launchArgs(list) {
  var out = { port: "4173", extra: ["--no-open"] }, seenPort = false, seenDir = false;
  for (var i = 0; i < list.length; i++) {
    var s = list[i], v = i + 1 < list.length ? list[i + 1] : null;
    if (s === "--port" && !seenPort && v !== null && /^[0-9]{2,5}$/.test(v)) {
      out.port = v; out.extra.push("--port", v); seenPort = true; i++;
    } else if (s === "--data-dir" && !seenDir && v !== null && SAFE.test(v) && DRIVE.test(v)) {
      out.extra.push("--data-dir", "\"" + v + "\""); seenDir = true; i++;
    } else {
      break;   // anything else ends the arguments: nothing after it is read
    }
  }
  return out;
}

/** cmd /d /c ""<bat>" args": cmd strips the outer pair of quotes. */
function commandLine(comspec, bat, extra) {
  return "\"" + comspec + "\" /d /c \"\"" + bat + "\" " + extra.join(" ") + "\"";
}

/** Does a dashboard already answer on this port? (127.0.0.1 is an allowed Host.) */
function dashboardAnswers(port) {
  try {
    var x = new ActiveXObject("MSXML2.ServerXMLHTTP.6.0");
    x.setTimeouts(1500, 1500, 2500, 2500);
    x.open("GET", "http://127.0.0.1:" + port + "/api/health?quick=1", false);
    x.send();
    return x.status === 200 && /"app"\s*:\s*"dashboard"/.test(String(x.responseText));
  } catch (e) { return false; }
}

/** True when it was started less than COOLDOWN_MS ago; otherwise notes the time now. */
function startedRecently(fso, folder, port, now) {
  try {
    var f = folder + "\\dashboard-start-" + port + ".stamp";
    if (fso.FileExists(f)) {
      var r = fso.OpenTextFile(f, 1);
      var t = Number(r.AtEndOfStream ? "0" : r.ReadAll());
      r.Close();
      if (t > 0 && now >= t && now - t < COOLDOWN_MS) return true;
    }
    var w = fso.CreateTextFile(f, true);
    w.Write(String(now));
    w.Close();
  } catch (e) { /* no stamp: start anyway */ }
  return false;
}

function main() {
  var fso = new ActiveXObject("Scripting.FileSystemObject");
  var sh = new ActiveXObject("WScript.Shell");
  var env = sh.Environment("PROCESS");
  var dry = String(env.Item("DASHBOARD_LAUNCHER_DRY_RUN") || "");
  var say = function (s) { if (dry) WScript.Echo(s); };
  var root = fso.GetParentFolderName(fso.GetParentFolderName(WScript.ScriptFullName));
  var bat = root + "\\start-opendash.bat";
  if (!fso.FileExists(bat)) bat = root + "\\start-dashboard.bat";
  if (!SAFE.test(root) || !fso.FileExists(bat)) { say("skip: no usable start-opendash.bat or start-dashboard.bat"); return; }
  var list = [];
  for (var i = 0; i < WScript.Arguments.length; i++) list.push(String(WScript.Arguments.Item(i)));
  var a = launchArgs(list);
  if (dashboardAnswers(a.port)) { say("skip: already running on port " + a.port); return; }
  var stampDir = dry && fso.FolderExists(dry) ? dry : fso.GetSpecialFolder(2).Path;
  if (startedRecently(fso, stampDir, a.port, new Date().getTime())) { say("skip: started less than 20 s ago"); return; }
  var cmd = commandLine(sh.ExpandEnvironmentStrings("%ComSpec%"), bat, a.extra);
  if (dry) { say("run: " + cmd); return; }
  env.Item("DASHBOARD_NO_PAUSE") = "1";
  sh.CurrentDirectory = root;
  sh.Run(cmd, 0, false);   // 0 = hidden window, do not wait
}
main();
]]></script>
</job>
